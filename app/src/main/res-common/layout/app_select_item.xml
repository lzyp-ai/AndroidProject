<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/dp_6"
    android:background="@drawable/transparent_selector"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/dp_15"
    android:paddingVertical="@dimen/dp_5">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_app_select_icon"
        android:layout_width="@dimen/dp_30"
        android:layout_height="@dimen/dp_30"
        android:scaleType="centerCrop"
        tools:src="@drawable/avatar_placeholder_ic" />

    <LinearLayout
        android:layout_width="0px"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_12"
        android:layout_weight="1"
        android:orientation="vertical">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_app_select_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:textColor="@color/black80"
            android:textSize="@dimen/sp_12"
            android:textStyle="bold"
            tools:text="应用名称" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_app_select_package"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_2"
            android:singleLine="true"
            android:textColor="@color/black40"
            android:textSize="@dimen/sp_10"
            tools:text="com.example.package" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_app_select_version"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_2"
            android:singleLine="true"
            android:textColor="@color/black40"
            android:textSize="@dimen/sp_10"
            tools:text="版本: 1.0.0" />
    </LinearLayout>

</LinearLayout>