<?xml version="1.0" encoding="utf-8"?>
<com.hjq.shape.layout.ShapeLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_gravity="bottom"
    android:layout_marginTop="@dimen/dp_20"
    android:orientation="vertical"
    app:shape_radiusInTopLeft="@dimen/dp_20"
    app:shape_radiusInTopRight="@dimen/dp_20"
    app:shape_solidColor="@color/white"
    app:shape_type="rectangle"
    tools:context=".ui.dialog.common.FileDialog">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/dp_15">

        <com.hjq.custom.widget.view.SmartTextView
            android:id="@+id/tv_file_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:gravity="center"
            android:text="选择文件"
            android:textColor="#333333"
            android:textSize="@dimen/sp_15"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_file_close"
            android:layout_width="@dimen/dp_25"
            android:layout_height="@dimen/dp_25"
            android:layout_gravity="end|center_vertical"
            android:padding="@dimen/dp_5"
            app:srcCompat="@drawable/close_icon" />

    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/line_size"
        android:background="#ececec" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/sl_file_device_layout"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/ll_storage_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/common_line_color"
                android:orientation="vertical"
                android:padding="@dimen/dp_15"
                android:visibility="gone">

                <com.hjq.custom.widget.view.SmartTextView
                    android:id="@+id/tv_storage_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#666666"
                    android:textSize="@dimen/sp_12"
                    tools:text="已用 12GB / 总计 64GB" />

                <ProgressBar
                    android:id="@+id/pb_storage_usage"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_6"
                    android:layout_marginTop="@dimen/dp_8"
                    android:max="100"
                    android:progress="30"
                    android:progressDrawable="@drawable/storage_progress_drawable" />

            </LinearLayout>

            <View
                android:id="@+id/v_storage_divider"
                android:layout_width="match_parent"
                android:layout_height="@dimen/line_size"
                android:background="#ececec"
                android:visibility="gone" />

            <com.scwang.smart.refresh.layout.SmartRefreshLayout
                android:id="@+id/srl_file_device_refresh"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@color/common_line_color"
                android:fillViewport="true">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_file_device_list"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/common_line_color"
                    android:clipToPadding="false"
                    android:gravity="fill"
                    android:paddingTop="@dimen/dp_10"
                    tools:layoutManager="LinearLayoutManager"
                    tools:listitem="@layout/file_device_item" />

            </com.scwang.smart.refresh.layout.SmartRefreshLayout>

        </LinearLayout>

        <View
            android:layout_width="@dimen/line_size"
            android:layout_height="match_parent"
            android:background="#ececec" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="3"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/ll_file_path"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="@dimen/dp_15"
                android:paddingVertical="@dimen/dp_10">

                <com.hjq.custom.widget.view.SmartTextView
                    android:id="@+id/tv_file_path"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="middle"
                    android:gravity="center_vertical"
                    android:singleLine="true"
                    android:textColor="@color/common_text_hint_color"
                    android:textSize="@dimen/sp_12"
                    tools:text="/storage/emulated/0" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/line_size"
                android:background="#ececec" />

            <com.hjq.custom.widget.layout.SimpleLayout
                android:id="@+id/sl_file_content_layout"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <com.scwang.smart.refresh.layout.SmartRefreshLayout
                    android:id="@+id/srl_file_content_refresh"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_file_content_list"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        tools:layoutManager="LinearLayoutManager"
                        tools:listitem="@layout/file_content_item" />

                </com.scwang.smart.refresh.layout.SmartRefreshLayout>

            </com.hjq.custom.widget.layout.SimpleLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/line_size"
                android:background="#ececec" />


            <LinearLayout
                android:id="@+id/ll_folder_confirm_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingVertical="@dimen/dp_5"
                android:visibility="gone">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/tv_folder_confirm"
                    style="@style/ButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="确认" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

</com.hjq.shape.layout.ShapeLinearLayout>
