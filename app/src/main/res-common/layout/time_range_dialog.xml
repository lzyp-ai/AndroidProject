<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/dp_10"
    android:paddingTop="@dimen/dp_15"
    android:paddingBottom="@dimen/dp_5"
    tools:context=".ui.dialog.common.TimeRangeDialog">

    <!-- 时间选择器容器：左右分布 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- 开始时间（左侧） -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <!-- 开始时间标签 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/time_range_start"
                android:textSize="@dimen/sp_14"
                android:textColor="@color/gray_999"
                android:paddingBottom="@dimen/dp_5"/>

            <!-- 开始时间选择器 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_start_hour"
                    android:layout_width="0px"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    tools:itemCount="3"
                    tools:listitem="@layout/picker_item" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_start_minute"
                    android:layout_width="0px"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    tools:itemCount="3"
                    tools:listitem="@layout/picker_item" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_start_second"
                    android:layout_width="0px"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    tools:itemCount="3"
                    tools:listitem="@layout/picker_item" />
            </LinearLayout>
        </LinearLayout>

        <!-- 中间分隔符 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="~"
            android:textSize="@dimen/sp_20"
            android:textColor="@color/gray_999"
            android:layout_marginHorizontal="@dimen/dp_10"
            android:layout_gravity="center_vertical"/>

        <!-- 结束时间（右侧） -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <!-- 结束时间标签 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/time_range_end"
                android:textSize="@dimen/sp_14"
                android:textColor="@color/gray_999"
                android:paddingBottom="@dimen/dp_5"/>

            <!-- 结束时间选择器 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_end_hour"
                    android:layout_width="0px"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    tools:itemCount="3"
                    tools:listitem="@layout/picker_item" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_end_minute"
                    android:layout_width="0px"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    tools:itemCount="3"
                    tools:listitem="@layout/picker_item" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_end_second"
                    android:layout_width="0px"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    tools:itemCount="3"
                    tools:listitem="@layout/picker_item" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
