<?xml version="1.0" encoding="utf-8"?>
<com.hjq.shape.layout.ShapeLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_gravity="bottom"
    android:layout_marginLeft="@dimen/dp_100"
    android:layout_marginTop="@dimen/dp_10"
    android:layout_marginRight="@dimen/dp_100"
    android:orientation="vertical"
    android:maxHeight="600dp"
    app:shape_radiusInTopLeft="@dimen/dp_20"
    app:shape_radiusInTopRight="@dimen/dp_20"
    app:shape_solidColor="@color/white"
    app:shape_type="rectangle"
    tools:context=".ui.dialog.common.AppSelectDialog">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/dp_10">

        <!-- 标题模式（默认显示） -->
        <LinearLayout
            android:id="@+id/ll_app_select_title_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- 左侧占位，与右侧两个图标等宽，保证标题真正居中 -->
            <Space
                android:layout_width="@dimen/dp_60"
                android:layout_height="@dimen/dp_30" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_app_select_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="选择应用"
                android:textColor="#333333"
                android:textSize="@dimen/sp_15" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_app_select_search"
                android:layout_width="@dimen/dp_30"
                android:layout_height="@dimen/dp_30"
                android:padding="@dimen/dp_5"
                app:srcCompat="@drawable/search_ic" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_app_select_close"
                android:layout_width="@dimen/dp_30"
                android:layout_height="@dimen/dp_30"
                android:padding="@dimen/dp_5"
                app:srcCompat="@drawable/close_icon" />

        </LinearLayout>

        <!-- 搜索模式（点击搜索图标后显示） -->
        <LinearLayout
            android:id="@+id/ll_app_select_search_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="@dimen/dp_20"
                android:layout_height="@dimen/dp_20"
                android:layout_marginStart="@dimen/dp_5"
                app:srcCompat="@drawable/search_ic" />

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/et_app_select_search"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="@dimen/dp_5"
                android:background="@null"
                android:hint="输入应用名称或包名"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="#333333"
                android:textColorHint="#aaaaaa"
                android:textSize="@dimen/sp_14" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_app_select_search_close"
                android:layout_width="@dimen/dp_30"
                android:layout_height="@dimen/dp_30"
                android:padding="@dimen/dp_5"
                app:srcCompat="@drawable/close_icon" />

        </LinearLayout>

    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/line_size"
        android:background="#ececec" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_app_select_tab"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/dp_10" />
    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/line_size"
        android:background="#ececec" />

    <com.scwang.smart.refresh.layout.SmartRefreshLayout
        android:id="@+id/srl_app_select"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#F4F4F4"
        android:fillViewport="true">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_app_select_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </com.scwang.smart.refresh.layout.SmartRefreshLayout>

</com.hjq.shape.layout.ShapeLinearLayout>