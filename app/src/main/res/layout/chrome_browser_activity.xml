<?xml version="1.0" encoding="utf-8"?>
<!-- Chrome PC 风格浏览器主布局 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/chrome_bg"
    android:orientation="vertical">

    <com.hjq.bar.TitleBar
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title="浏览器" />


    <!-- 顶部区域：标签栏 + 地址栏 + 工具按钮 -->
    <LinearLayout
        android:id="@+id/ll_chrome_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/chrome_toolbar_bg"
        android:elevation="4dp"
        android:orientation="vertical">

        <!-- 标签页栏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_36"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/dp_8">

            <!-- 标签页滚动列表 -->
            <HorizontalScrollView
                android:id="@+id/hsv_chrome_tabs"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/ll_chrome_tab_container"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal" />

            </HorizontalScrollView>

            <!-- 新建标签页按钮 -->
            <ImageView
                android:id="@+id/iv_chrome_new_tab"
                android:layout_width="@dimen/dp_32"
                android:layout_height="@dimen/dp_32"
                android:layout_marginStart="@dimen/dp_4"
                android:background="@drawable/chrome_icon_btn_bg"
                android:contentDescription="@string/chrome_new_tab"
                android:padding="@dimen/dp_6"
                android:src="@drawable/chrome_add_ic"
                app:tint="@color/chrome_icon_color" />

        </LinearLayout>

        <!-- 地址栏 + 导航按钮行 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_44"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/dp_6"
            android:paddingVertical="@dimen/dp_4">

            <!-- 后退按钮 -->
            <ImageView
                android:id="@+id/iv_chrome_back"
                android:layout_width="@dimen/dp_36"
                android:layout_height="@dimen/dp_36"
                android:alpha="0.4"
                android:background="@drawable/chrome_icon_btn_bg"
                android:contentDescription="@string/chrome_go_back"
                android:padding="@dimen/dp_8"
                android:src="@drawable/chrome_back_ic"
                app:tint="@color/chrome_icon_color" />

            <!-- 前进按钮 -->
            <ImageView
                android:id="@+id/iv_chrome_forward"
                android:layout_width="@dimen/dp_36"
                android:layout_height="@dimen/dp_36"
                android:alpha="0.4"
                android:background="@drawable/chrome_icon_btn_bg"
                android:contentDescription="@string/chrome_go_forward"
                android:padding="@dimen/dp_8"
                android:src="@drawable/chrome_forward_ic"
                app:tint="@color/chrome_icon_color" />

            <!-- 地址栏容器 -->
            <LinearLayout
                android:id="@+id/ll_chrome_address_bar"
                android:layout_width="0dp"
                android:layout_height="@dimen/dp_32"
                android:layout_marginHorizontal="@dimen/dp_4"
                android:layout_weight="1"
                android:background="@drawable/chrome_address_bar_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/dp_8">

                <!-- 安全锁图标 -->
                <ImageView
                    android:id="@+id/iv_chrome_secure"
                    android:layout_width="@dimen/dp_14"
                    android:layout_height="@dimen/dp_14"
                    android:layout_marginEnd="@dimen/dp_4"
                    android:contentDescription="@string/chrome_secure"
                    android:src="@drawable/chrome_lock_ic"
                    app:tint="@color/chrome_secure_color" />

                <!-- URL 输入框 -->
                <EditText
                    android:id="@+id/et_chrome_url"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="@string/chrome_url_hint"
                    android:imeOptions="actionGo"
                    android:inputType="textUri"
                    android:maxLines="1"
                    android:selectAllOnFocus="true"
                    android:singleLine="true"
                    android:textColor="@color/chrome_url_text_color"
                    android:textColorHint="@color/chrome_url_hint_color"
                    android:textSize="@dimen/sp_13" />

                <!-- 刷新/停止按钮 -->
                <ImageView
                    android:id="@+id/iv_chrome_reload"
                    android:layout_width="@dimen/dp_20"
                    android:layout_height="@dimen/dp_20"
                    android:contentDescription="@string/chrome_reload"
                    android:src="@drawable/chrome_reload_ic"
                    app:tint="@color/chrome_icon_color" />

            </LinearLayout>

            <!-- 主页按钮 -->
            <ImageView
                android:id="@+id/iv_chrome_home"
                android:layout_width="@dimen/dp_36"
                android:layout_height="@dimen/dp_36"
                android:background="@drawable/chrome_icon_btn_bg"
                android:contentDescription="@string/chrome_go_home"
                android:padding="@dimen/dp_8"
                android:src="@drawable/chrome_home_ic"
                app:tint="@color/chrome_icon_color" />

            <!-- 更多菜单按钮 -->
            <ImageView
                android:id="@+id/iv_chrome_more"
                android:layout_width="@dimen/dp_36"
                android:layout_height="@dimen/dp_36"
                android:background="@drawable/chrome_icon_btn_bg"
                android:contentDescription="@string/chrome_more"
                android:padding="@dimen/dp_8"
                android:src="@drawable/chrome_more_ic"
                app:tint="@color/chrome_icon_color" />

        </LinearLayout>

        <!-- 加载进度条 -->
        <ProgressBar
            android:id="@+id/pb_chrome_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_3"
            android:progressDrawable="@drawable/progress_gradient_bg"
            android:visibility="gone" />

    </LinearLayout>

    <!-- 网页内容区域（FrameLayout 叠加：新标签页 + WebView 状态层） -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- 新标签页（空白起始页） -->
        <include
            android:id="@+id/include_chrome_new_tab"
            layout="@layout/chrome_browser_new_tab"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <!-- WebView 区域（带状态和下拉刷新） -->
        <com.hjq.demo.widget.StatusLayout
            android:id="@+id/sl_chrome_status"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <com.scwang.smart.refresh.layout.SmartRefreshLayout
                android:id="@+id/srl_chrome_refresh"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:srlEnableHeaderTranslationContent="false"
                app:srlEnableLoadMore="false"
                app:srlEnablePreviewInEditMode="false"
                app:srlPrimaryColor="#4285F4">

                <com.hjq.demo.widget.webview.BrowserView
                    android:id="@+id/wv_chrome_browser"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

            </com.scwang.smart.refresh.layout.SmartRefreshLayout>

        </com.hjq.demo.widget.StatusLayout>

    </FrameLayout>

</LinearLayout>
