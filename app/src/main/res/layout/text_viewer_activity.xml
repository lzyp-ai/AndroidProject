<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.hjq.bar.TitleBar
        android:id="@+id/tb_text_viewer_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- 工具栏：编码 / 行列信息 / 只读切换 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/common_line_color"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/dp_10"
        android:paddingVertical="@dimen/dp_6">

        <!-- 编码切换按钮 -->
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_text_viewer_encoding"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/transparent_selector"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="@dimen/dp_8"
            android:paddingVertical="@dimen/dp_4"
            android:text="UTF-8"
            android:textColor="@color/common_confirm_text_color"
            android:textSize="@dimen/sp_12" />

        <View
            android:layout_width="@dimen/line_size"
            android:layout_height="@dimen/dp_12"
            android:layout_marginHorizontal="@dimen/dp_6"
            android:background="@color/common_text_hint_color" />

        <!-- 行列信息 -->
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_text_viewer_position"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="第 1 行"
            android:textColor="@color/common_text_hint_color"
            android:textSize="@dimen/sp_12" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- 撤销 -->
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_text_viewer_undo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/transparent_selector"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="@dimen/dp_8"
            android:paddingVertical="@dimen/dp_4"
            android:text="撤销"
            android:textColor="@color/common_text_hint_color"
            android:textSize="@dimen/sp_12" />

        <!-- 重做 -->
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_text_viewer_redo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/transparent_selector"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="@dimen/dp_8"
            android:paddingVertical="@dimen/dp_4"
            android:text="重做"
            android:textColor="@color/common_text_hint_color"
            android:textSize="@dimen/sp_12" />

        <!-- 只读/编辑 切换 -->
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_text_viewer_mode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/transparent_selector"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="@dimen/dp_8"
            android:paddingVertical="@dimen/dp_4"
            android:text="编辑"
            android:textColor="@color/common_confirm_text_color"
            android:textSize="@dimen/sp_12" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/line_size"
        android:background="@color/common_line_color" />

    <!-- 查找栏（默认隐藏） -->
    <LinearLayout
        android:id="@+id/ll_text_viewer_search"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/dp_10"
        android:paddingVertical="@dimen/dp_6"
        android:visibility="gone">

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/et_text_viewer_search"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@color/common_line_color"
            android:hint="查找内容..."
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:paddingHorizontal="@dimen/dp_8"
            android:paddingVertical="@dimen/dp_6"
            android:singleLine="true"
            android:textSize="@dimen/sp_13" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_text_viewer_search_result"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/dp_8"
            android:textColor="@color/common_text_hint_color"
            android:textSize="@dimen/sp_12" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_text_viewer_search_prev"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/transparent_selector"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="@dimen/dp_6"
            android:paddingVertical="@dimen/dp_4"
            android:text="▲"
            android:textColor="@color/common_confirm_text_color"
            android:textSize="@dimen/sp_14" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_text_viewer_search_next"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/transparent_selector"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="@dimen/dp_6"
            android:paddingVertical="@dimen/dp_4"
            android:text="▼"
            android:textColor="@color/common_confirm_text_color"
            android:textSize="@dimen/sp_14" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_text_viewer_search_close"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/transparent_selector"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="@dimen/dp_8"
            android:paddingVertical="@dimen/dp_4"
            android:text="✕"
            android:textColor="@color/common_text_hint_color"
            android:textSize="@dimen/sp_14" />

    </LinearLayout>

    <!-- 内容编辑区 -->
    <ScrollView
        android:id="@+id/sv_text_viewer_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:visibility="gone">

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/et_text_viewer_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:enabled="false"
            android:gravity="top|start"
            android:lineSpacingMultiplier="1.5"
            android:padding="@dimen/dp_15"
            android:textColor="#333333"
            android:textCursorDrawable="@null"
            android:textSize="@dimen/sp_14"
            android:typeface="monospace" />

    </ScrollView>

    <!-- 加载中 -->
    <FrameLayout
        android:id="@+id/fl_text_viewer_loading"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center">

        <ProgressBar
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center" />

    </FrameLayout>

</LinearLayout>
