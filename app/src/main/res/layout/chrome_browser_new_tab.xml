<?xml version="1.0" encoding="utf-8"?>
<!-- Chrome 风格新标签页（空白起始页） -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/chrome_new_tab_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingVertical="@dimen/dp_40">

        <!-- 搜索框 -->
        <LinearLayout
            android:id="@+id/ll_chrome_new_tab_search"
            android:layout_width="@dimen/dp_500"
            android:layout_height="@dimen/dp_44"
            android:background="@drawable/chrome_search_bar_bg"
            android:elevation="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/dp_16">

            <EditText
                android:id="@+id/et_chrome_new_tab_search"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/chrome_search_hint"
                android:imeOptions="actionSearch"
                android:inputType="textUri"
                android:maxLines="1"
                android:singleLine="true"
                android:textColor="@color/chrome_url_text_color"
                android:textColorHint="@color/chrome_url_hint_color"
                android:textSize="@dimen/sp_14" />

            <ImageView
                android:id="@+id/iv_chrome_new_tab_search_btn"
                android:layout_width="@dimen/dp_18"
                android:layout_height="@dimen/dp_18"
                android:layout_marginStart="@dimen/dp_8"
                android:contentDescription="@string/chrome_search"
                android:src="@drawable/chrome_search_ic"
                app:tint="@color/chrome_search_icon_color" />

        </LinearLayout>

        <!-- 快速访问标题 -->
        <TextView
            android:layout_width="@dimen/dp_500"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_32"
            android:layout_marginBottom="@dimen/dp_12"
            android:text="@string/chrome_shortcuts"
            android:textColor="@color/chrome_shortcuts_title_color"
            android:textSize="@dimen/sp_13" />

        <!-- 快速访问横向滚动列表（书签 + 末尾固定加号） -->
        <HorizontalScrollView
            android:layout_width="@dimen/dp_500"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/ll_chrome_shortcuts_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- 书签动态列表（由 Java 代码动态插入） -->

                <!-- 末尾固定：添加快捷方式按钮 -->
                <LinearLayout
                    android:id="@+id/ll_chrome_add_shortcut"
                    android:layout_width="@dimen/dp_90"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="@dimen/dp_8">

                    <ImageView
                        android:layout_width="@dimen/dp_48"
                        android:layout_height="@dimen/dp_48"
                        android:background="@drawable/chrome_shortcut_icon_bg"
                        android:padding="@dimen/dp_12"
                        android:src="@drawable/chrome_add_ic"
                        app:tint="@color/chrome_shortcut_icon_color" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_6"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/chrome_add_shortcut"
                        android:textColor="@color/chrome_shortcut_text_color"
                        android:textSize="@dimen/sp_11" />

                </LinearLayout>

            </LinearLayout>

        </HorizontalScrollView>

    </LinearLayout>

</ScrollView>
