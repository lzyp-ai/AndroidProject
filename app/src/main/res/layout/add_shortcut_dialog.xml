<?xml version="1.0" encoding="utf-8"?>
<!-- 添加快捷方式弹框内容区域：名称 + 网址两个输入框 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/dp_15"
    android:paddingTop="@dimen/dp_8"
    android:paddingBottom="@dimen/dp_10">

    <!-- 名称标签 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_4"
        android:text="@string/chrome_shortcut_name_hint"
        android:textColor="#999999"
        android:textSize="@dimen/sp_12" />

    <!-- 名称输入框 -->
    <com.hjq.custom.widget.view.RegexEditText
        android:id="@+id/et_shortcut_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_12"
        android:background="@drawable/dialog_input_bg"
        android:paddingHorizontal="@dimen/dp_10"
        android:paddingVertical="@dimen/dp_5"
        android:singleLine="true"
        android:textColor="#333333"
        android:textSize="@dimen/sp_14" />

    <!-- 网址标签 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_4"
        android:text="@string/chrome_shortcut_url_hint"
        android:textColor="#999999"
        android:textSize="@dimen/sp_12" />

    <!-- 网址输入框 -->
    <com.hjq.custom.widget.view.RegexEditText
        android:id="@+id/et_shortcut_url"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/dialog_input_bg"
        android:inputType="textUri"
        android:paddingHorizontal="@dimen/dp_10"
        android:paddingVertical="@dimen/dp_5"
        android:singleLine="true"
        android:textColor="#333333"
        android:textSize="@dimen/sp_14" />

</LinearLayout>
