<?xml version="1.0" encoding="utf-8"?>
<com.hjq.shape.layout.ShapeLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:orientation="vertical"
    app:shape_radiusInTopLeft="@dimen/dp_20"
    app:shape_radiusInTopRight="@dimen/dp_20"
    app:shape_solidColor="@color/white"
    app:shape_type="rectangle"
    tools:context=".ui.dialog.AudioPlayerDialog">

    <!-- 标题栏：文件名 + 关闭 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/dp_15">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_audio_player_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginHorizontal="@dimen/dp_40"
            android:ellipsize="end"
            android:gravity="center"
            android:singleLine="true"
            android:textColor="@color/panda"
            android:textSize="@dimen/sp_15"
            android:textStyle="bold"
            tools:text="音乐文件名.mp3" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_audio_player_close"
            android:layout_width="@dimen/dp_28"
            android:layout_height="@dimen/dp_28"
            android:layout_gravity="end|center_vertical"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:padding="@dimen/dp_4"
            app:srcCompat="@drawable/close_icon" />

    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/line_size"
        android:background="@color/common_line_color" />

    <!-- 进度条 + 时间 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/dp_20"
        android:paddingTop="@dimen/dp_20">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_audio_player_current"
            android:layout_width="@dimen/dp_45"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textColor="@color/common_text_hint_color"
            android:textSize="@dimen/sp_12" />

        <SeekBar
            android:id="@+id/sb_audio_player_progress"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_audio_player_duration"
            android:layout_width="@dimen/dp_45"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="00:00"
            android:textColor="@color/common_text_hint_color"
            android:textSize="@dimen/sp_12" />

    </LinearLayout>

    <!-- 播放控制按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingVertical="@dimen/dp_24">

        <!-- 快退 15s -->
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_audio_player_rewind"
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_48"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:padding="@dimen/dp_8"
            app:srcCompat="@drawable/video_schedule_rewind_ic"
            app:tint="@color/panda" />

        <!-- 播放/暂停 -->
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_audio_player_toggle"
            android:layout_width="@dimen/dp_64"
            android:layout_height="@dimen/dp_64"
            android:layout_marginHorizontal="@dimen/dp_40"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:padding="@dimen/dp_4"
            app:srcCompat="@drawable/audio_play_ic"
            app:tint="@color/panda"/>

        <!-- 快进 15s -->
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_audio_player_forward"
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_48"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:padding="@dimen/dp_8"
            app:srcCompat="@drawable/video_schedule_forward_ic"
            app:tint="@color/panda" />

    </LinearLayout>

</com.hjq.shape.layout.ShapeLinearLayout>
