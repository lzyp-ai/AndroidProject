<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.activity.FileManagerActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

    <com.hjq.bar.TitleBar
        android:id="@+id/tb_file_manager_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title="文件管理"
        app:rightTitle="@string/ftp_entry_menu_item"
        app:rightTitleColor="@color/black"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/line_size"
        android:background="@color/common_line_color" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- 左侧设备列表 -->
        <LinearLayout
            android:id="@+id/ll_file_manager_device"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/common_line_color"
            android:orientation="vertical">

            <!-- 存储空间信息 -->
            <LinearLayout
                android:id="@+id/ll_file_manager_storage_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/common_line_color"
                android:orientation="vertical"
                android:padding="@dimen/dp_15"
                android:visibility="gone">

                <com.hjq.custom.widget.view.SmartTextView
                    android:id="@+id/tv_file_manager_storage_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#666666"
                    android:textSize="@dimen/sp_12"
                    tools:text="已用 12GB / 总计 64GB" />

                <ProgressBar
                    android:id="@+id/pb_file_manager_storage_usage"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_6"
                    android:layout_marginTop="@dimen/dp_8"
                    android:max="100"
                    android:progress="30"
                    android:progressDrawable="@drawable/storage_progress_drawable" />

            </LinearLayout>

            <View
                android:id="@+id/v_file_manager_storage_divider"
                android:layout_width="match_parent"
                android:layout_height="@dimen/line_size"
                android:background="@color/common_line_color"
                android:visibility="gone" />

            <!-- 设备列表 -->
            <com.scwang.smart.refresh.layout.SmartRefreshLayout
                android:id="@+id/srl_file_manager_device_refresh"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_file_manager_device_list"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/common_line_color"
                    android:clipToPadding="false"
                    android:paddingTop="@dimen/dp_10"
                    tools:layoutManager="LinearLayoutManager"
                    tools:listitem="@layout/file_device_item" />

            </com.scwang.smart.refresh.layout.SmartRefreshLayout>

        </LinearLayout>

        <View
            android:layout_width="@dimen/line_size"
            android:layout_height="match_parent"
            android:background="@color/common_line_color" />

        <!-- 右侧文件列表 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="3"
            android:background="@color/white"
            android:orientation="vertical">

            <!-- 路径导航栏 -->
            <LinearLayout
                android:id="@+id/ll_file_manager_path"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="@dimen/dp_15"
                android:paddingVertical="@dimen/dp_10">

                <com.hjq.custom.widget.view.SmartTextView
                    android:id="@+id/tv_file_manager_path"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="middle"
                    android:gravity="center_vertical"
                    android:singleLine="true"
                    android:textColor="@color/common_text_hint_color"
                    android:textSize="@dimen/sp_12"
                    tools:text="/storage/emulated/0" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/line_size"
                android:background="@color/common_line_color" />

            <!-- 文件列表 -->
            <com.scwang.smart.refresh.layout.SmartRefreshLayout
                android:id="@+id/srl_file_manager_content_refresh"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_file_manager_content_list"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    tools:layoutManager="LinearLayoutManager"
                    tools:listitem="@layout/file_content_item" />

            </com.scwang.smart.refresh.layout.SmartRefreshLayout>

        </LinearLayout>

    </LinearLayout>

    </LinearLayout>

    <!-- 悬浮新建按钮 -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_file_manager_new"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/dp_20"
        android:contentDescription="新建"
        android:src="@drawable/add_ic"
        app:fabSize="normal"
        app:tint="@color/white" />

</FrameLayout>